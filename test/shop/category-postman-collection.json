      ]
    },
    {
      "name": "数据清理",
      "item": [
        {
          "name": "删除测试分类",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"ids\": [{{testCategoryId}}]\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/admin/shop/category/delete",
              "host": ["{{baseUrl}}"],
              "path": ["admin", "shop", "category", "delete"]
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('删除分类成功', function () {",
                  "    pm.response.to.have.status(200);",
                  "    const responseJson = pm.response.json();",
                  "    pm.expect(responseJson.code).to.eql(1000);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        }
      ]
    }
  ]
