                  "});",
                  "",
                  "pm.test('返回参数错误', function () {",
                  "    const responseJson = pm.response.json();",
                  "    pm.expect(responseJson.code).to.not.eql(1000);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "获取分类商品列表 - 参数类型错误",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/app/shop/category/goodsList?categoryId=abc",
              "host": ["{{baseUrl}}"],
              "path": ["app", "shop", "category", "goodsList"],
              "query": [
                {
                  "key": "categoryId",
                  "value": "abc"
                }
              ]
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
